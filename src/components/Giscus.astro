---
// Giscus 评论组件 - 基于 GitHub Discussions
// 使用前需要先在 GitHub Settings > Applications > Giscus 授权
---

<div id="giscus-container" class="mt-8">
  <h2 class="font-serif text-2xl font-bold text-tibet-blue mb-4">评论</h2>
  <div id="giscus"></div>
</div>

<script src="https://giscus.app/client.js"
  data-repo="你的用户名/你的仓库"
  data-repo-id="你的仓库ID"
  data-category="Announcements"
  data-category-id="DIC_kwDOA"
  data-mapping="pathname"
  data-strict="0"
  data-reactions-enabled="1"
  data-emit-metadata="0"
  data-input-position="top"
  data-theme="light"
  data-lang="zh-CN"
  data-loading="lazy"
  crossorigin="anonymous"
  async>
</script>

<style>
  #giscus-container .giscus {
    width: 100%;
  }
</style>
