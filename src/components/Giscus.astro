---
interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

<div class="giscus-container mt-8">
  <h3 class="font-serif text-lg font-bold text-gray-900 mb-4">评论</h3>
  <div class="giscus"></div>
</div>

<script
  src="https://giscus.app/client.js"
  data-repo="fieldsterling/tibet"
  data-repo-id="R_kgDOJeU"
  data-category="General"
  data-category-id="DIC_kwDOJeUs4C4CZX"
  data-mapping="specific"
  data-term={slug}
  data-strict="0"
  data-reactions-enabled="1"
  data-emit-metadata="0"
  data-input-position="bottom"
  data-theme="light"
  data-lang="zh-CN"
  data-loading="lazy"
  crossorigin="anonymous"
  async>
</script>

<style>
  .giscus-container {
    padding: 1.5rem;
    background: #f9fafb;
    border-radius: 0.75rem;
  }
</style>
