---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="西藏时空地图志 - 以地图为核心的西藏地区地理、历史、旅行与修行文化知识站点" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;600;700&family=Noto+Sans+SC:wght@300;400;500;700&display=swap" rel="stylesheet" />
  </head>
  <body class="font-sans bg-tibet-cream text-gray-900">
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --color-tibet-blue: #1a4b6e;
    --color-tibet-red: #c41e3a;
    --color-tibet-gold: #d4a84b;
    --color-tibet-cream: #f5f0e8;
  }
  
  html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  
  .font-serif {
    font-family: 'Noto Serif SC', serif;
  }
  
  .font-sans {
    font-family: 'Noto Sans SC', sans-serif;
  }
</style>
