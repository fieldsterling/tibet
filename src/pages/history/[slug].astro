---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import Giscus from '../../components/Giscus';

export async function getStaticPaths() {
  const histories = await getCollection('histories');
  return histories.map(history => ({
    params: { slug: history.slug },
    props: { history }
  }));
}

const { history } = Astro.props;
const { Content } = await history.render();
---

<Layout title={history.data.title}>
  <div class="min-h-screen bg-tibet-cream">
    {/* 头部 */}
    <header class="bg-gradient-to-r from-tibet-blue to-tibet-red text-white py-12">
      <div class="max-w-4xl mx-auto px-4">
        <a href="/" class="inline-flex items-center text-white/80 hover:text-white mb-6">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M15 19l-7-7 7-7" />
          </svg>
          返回地图
        </a>
        <h1 class="font-serif text-3xl md:text-4xl font-bold mb-4">{history.data.title}</h1>
        <div class="flex flex-wrap items-center gap-4 text-white/90">
          <span class="flex items-center gap-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            {history.data.author}
          </span>
          <span class="flex items-center gap-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            {history.data.era?.join(' / ')} 年
          </span>
        </div>
      </div>
    </header>

    {/* 时间轴地图 */}
    {history.data.events && history.data.events.length > 0 && (
      <div class="bg-white shadow-lg">
        <div id="timeline-map" class="h-64 md:h-96"></div>
      </div>
    )}

    {/* 内容 */}
    <main class="max-w-4xl mx-auto px-4 py-8">
      <article class="prose prose-lg max-w-none">
        <Content />
      </article>

      {/* 历史时间轴 */}
      {history.data.events && history.data.events.length > 0 && (
        <div class="mt-12">
          <h2 class="font-serif text-2xl font-bold text-tibet-blue mb-6">历史事件</h2>
          <div class="relative">
            {/* 时间线 */}
            <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-gray-200"></div>
            
            <div class="space-y-8">
              {history.data.events.sort((a, b) => a.year - b.year).map((event: any, index: number) => (
                <div class="relative pl-12">
                  <div class="absolute left-2 w-4 h-4 rounded-full bg-tibet-blue border-4 border-white"></div>
                  <div class="bg-white rounded-xl p-4 shadow-md">
                    <div class="text-2xl font-bold text-tibet-red mb-2">{event.year}年</div>
                    <p class="text-gray-700">{event.desc}</p>
                    {event.image && (
                      <img src={event.image} alt="" class="mt-3 w-full max-w-md rounded-lg" />
                    )}
                    <div class="mt-2 text-sm text-gray-500">
                      📍 {event.lat.toFixed(4)}, {event.lng.toFixed(4)}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      )}

      {/* 评论 */}
      <div class="mt-12">
        <Giscus />
      </div>
    </main>
  </div>
</Layout>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  const mapDiv = document.getElementById('timeline-map');
  if (mapDiv) {
    const events = (window as any).__HISTORY_EVENTS__ || [];
    if (events.length > 0) {
      const map = L.map('timeline-map');
      
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 18,
      }).addTo(map);

      const markers: L.CircleMarker[] = [];
      events.forEach((event: any, index: number) => {
        const marker = L.circleMarker([event.lat, event.lng], {
          radius: 8,
          fillColor: '#c41e3a',
          color: '#fff',
          weight: 2
        }).bindPopup(`<strong>${event.year}年</strong><br>${event.desc}`).addTo(map);
        markers.push(marker);
      });

      if (markers.length > 0) {
        const group = L.featureGroup(markers);
        map.fitBounds(group.getBounds(), { padding: [20, 20] });
      }
    }
  }
</script>
