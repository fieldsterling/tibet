---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import Giscus from '../../components/Giscus';

export async function getStaticPaths() {
  const businesses = await getCollection('businesses');
  return businesses.map(business => ({
    params: { slug: business.slug },
    props: { business }
  }));
}

const { business } = Astro.props;
const { Content } = await business.render();

const typeColors: Record<string, string> = {
  '住宿': 'bg-purple-100 text-purple-700',
  '餐饮': 'bg-orange-100 text-orange-700',
  '交通': 'bg-blue-100 text-blue-700',
  '补给': 'bg-green-100 text-green-700',
  '其他': 'bg-gray-100 text-gray-700'
};
---

<Layout title={business.data.title}>
  <div class="min-h-screen bg-tibet-cream">
    {/* 头部 */}
    <header class="bg-gradient-to-r from-tibet-blue to-tibet-red text-white py-12">
      <div class="max-w-4xl mx-auto px-4">
        <a href="/" class="inline-flex items-center text-white/80 hover:text-white mb-6">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M15 19l-7-7 7-7" />
          </svg>
          返回地图
        </a>
        <h1 class="font-serif text-3xl md:text-4xl font-bold mb-4">{business.data.title}</h1>
        <div class="flex flex-wrap items-center gap-4">
          <span class={`px-3 py-1 rounded-full text-sm ${typeColors[business.data.type] || 'bg-gray-100 text-gray-700'}`}>
            {business.data.type}
          </span>
          <div class="flex gap-2">
            {business.data.tags.map((tag: string) => (
              <span class="px-3 py-1 bg-white/20 rounded-full text-sm">{tag}</span>
            ))}
          </div>
        </div>
      </div>
    </header>

    {/* 位置地图 */}
    <div class="bg-white shadow-lg">
      <div id="location-map" class="h-64 md:h-96" data-lat={business.data.lat} data-lng={business.data.lng}></div>
    </div>

    {/* 内容 */}
    <main class="max-w-4xl mx-auto px-4 py-8">
      <article class="prose prose-lg max-w-none">
        <Content />
      </article>

      {/* 联系信息 */}
      <div class="mt-8 bg-white rounded-xl p-6 shadow-md">
        <h2 class="font-serif text-xl font-bold text-tibet-blue mb-4">联系信息</h2>
        <div class="space-y-3">
          {business.data.contact && (
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              <span>{business.data.contact}</span>
            </div>
          )}
          {business.data.website && (
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
              </svg>
              <a href={business.data.website} target="_blank" class="text-tibet-blue hover:underline">{business.data.website}</a>
            </div>
          )}
          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>{business.data.lat.toFixed(4)}, {business.data.lng.toFixed(4)}</span>
          </div>
        </div>
      </div>

      {/* 图片 */}
      {business.data.images && business.data.images.length > 0 && (
        <div class="mt-8">
          <h2 class="font-serif text-xl font-bold text-tibet-blue mb-4">图片</h2>
          <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
            {business.data.images.map((image: string) => (
              <img src={image} alt="" class="w-full h-48 object-cover rounded-xl" />
            ))}
          </div>
        </div>
      )}

      {/* 评论 */}
      <div class="mt-12">
        <Giscus />
      </div>
    </main>
  </div>
</Layout>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  const mapDiv = document.getElementById('location-map') as HTMLElement;
  if (mapDiv) {
    const lat = parseFloat(mapDiv.dataset.lat || '0');
    const lng = parseFloat(mapDiv.dataset.lng || '0');
    
    const map = L.map('location-map').setView([lat, lng], 14);
    
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 18,
    }).addTo(map);

    L.circleMarker([lat, lng], {
      radius: 10,
      fillColor: '#c41e3a',
      color: '#fff',
      weight: 2
    }).addTo(map);
  }
</script>
