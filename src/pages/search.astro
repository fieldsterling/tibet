---
import Layout from '../layouts/Layout.astro';
---

<Layout title="搜索 - 西藏时空地图志">
  <div class="min-h-screen bg-tibet-cream">
    {/* 头部 */}
    <header class="bg-gradient-to-r from-tibet-blue to-tibet-red text-white py-8">
      <div class="max-w-4xl mx-auto px-4">
        <a href="/" class="inline-flex items-center text-white/80 hover:text-white mb-4">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M15 19l-7-7 7-7" />
          </svg>
          返回地图
        </a>
        <h1 class="font-serif text-3xl font-bold">全站搜索</h1>
      </div>
    </header>

    {/* 搜索框 */}
    <div class="max-w-4xl mx-auto px-4 -mt-6">
      <div class="bg-white rounded-xl shadow-lg p-4">
        <div class="flex items-center gap-4">
          <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input
            type="text"
            id="search-input"
            placeholder="输入关键词搜索..."
            class="flex-1 text-lg outline-none"
          />
        </div>
      </div>
    </div>

    {/* 搜索结果 */}
    <main class="max-w-4xl mx-auto px-4 py-8">
      <div id="search-results" class="space-y-4">
        <p class="text-gray-500 text-center py-12">
          输入关键词开始搜索
        </p>
      </div>
    </main>
  </div>
</Layout>

<script is:inline>
  // Pagefind 搜索
  async function searchPagefind(query) {
    const resultsContainer = document.getElementById('search-results');
    if (!query.trim()) {
      resultsContainer.innerHTML = '<p class="text-gray-500 text-center py-12">输入关键词开始搜索</p>';
      return;
    }

    try {
      // @ts-ignore
      const pagefind = await import('/pagefind/pagefind.js');
      await pagefind.init();
      const results = await pagefind.search(query);

      if (results.results.length === 0) {
        resultsContainer.innerHTML = '<p class="text-gray-500 text-center py-12">未找到相关结果</p>';
        return;
      }

      const items = await Promise.all(
        results.results.slice(0, 20).map(async (result) => {
          const data = await result.data();
          return `
            <a href="${data.url}" class="block bg-white rounded-xl p-4 shadow-md hover:shadow-lg transition-shadow">
              <h3 class="font-serif font-semibold text-tibet-blue mb-2">${data.meta?.title || '无标题'}</h3>
              <p class="text-gray-600 text-sm line-clamp-2">${data.excerpt || ''}</p>
            </a>
          `;
        })
      );

      resultsContainer.innerHTML = items.join('');
    } catch (e) {
      console.error('Search error:', e);
      resultsContainer.innerHTML = '<p class="text-gray-500 text-center py-12">搜索服务加载中，请稍后再试...</p>';
    }
  }

  // 防抖
  let debounceTimer;
  document.getElementById('search-input').addEventListener('input', (e) => {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => {
      searchPagefind(e.target.value);
    }, 300);
  });
</script>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
