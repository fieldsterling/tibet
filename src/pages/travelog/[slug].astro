---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import Giscus from '../../components/Giscus';

export async function getStaticPaths() {
  const travelogs = await getCollection('travelogs');
  return travelogs.map(travelog => ({
    params: { slug: travelog.slug },
    props: { travelog }
  }));
}

const { travelog } = Astro.props;
const { Content } = await travelog.render();
---

<Layout title={travelog.data.title}>
  <div class="min-h-screen bg-tibet-cream">
    {/* 头部 */}
    <header class="bg-gradient-to-r from-tibet-blue to-tibet-red text-white py-12">
      <div class="max-w-4xl mx-auto px-4">
        <a href="/" class="inline-flex items-center text-white/80 hover:text-white mb-6">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M15 19l-7-7 7-7" />
          </svg>
          返回地图
        </a>
        <h1 class="font-serif text-3xl md:text-4xl font-bold mb-4">{travelog.data.title}</h1>
        <div class="flex flex-wrap items-center gap-4 text-white/90">
          <span class="flex items-center gap-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            {travelog.data.author}
          </span>
          <span class="flex items-center gap-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            {new Date(travelog.data.date).toLocaleDateString('zh-CN')}
          </span>
        </div>
        <div class="flex gap-2 mt-4">
          {travelog.data.tags.map((tag: string) => (
            <span class="px-3 py-1 bg-white/20 rounded-full text-sm">{tag}</span>
          ))}
        </div>
      </div>
    </header>

    {/* 路线图 */}
    {travelog.data.points && travelog.data.points.length > 0 && (
      <div class="bg-white shadow-lg">
        <div id="route-map" class="h-64 md:h-96"></div>
      </div>
    )}

    {/* 内容 */}
    <main class="max-w-4xl mx-auto px-4 py-8">
      <article class="prose prose-lg max-w-none">
        <Content />
      </article>

      {/* 地点列表 */}
      {travelog.data.points && travelog.data.points.length > 0 && (
        <div class="mt-12">
          <h2 class="font-serif text-2xl font-bold text-tibet-blue mb-6">行程足迹</h2>
          <div class="space-y-4">
            {travelog.data.points.map((point: any, index: number) => (
              <div class="bg-white rounded-xl p-4 shadow-md">
                <div class="flex items-start gap-4">
                  <div class="w-8 h-8 rounded-full bg-tibet-blue text-white flex items-center justify-center font-bold flex-shrink-0">
                    {index + 1}
                  </div>
                  <div class="flex-1">
                    <h3 class="font-serif font-semibold text-gray-900">{point.name}</h3>
                    {point.date && (
                      <p class="text-sm text-gray-500 mt-1">
                        {new Date(point.date).toLocaleDateString('zh-CN')}
                      </p>
                    )}
                    <p class="text-gray-700 mt-2">{point.desc}</p>
                    {point.image && (
                      <img 
                        src={point.image} 
                        alt={point.name}
                        class="mt-3 w-full max-w-md rounded-lg"
                      />
                    )}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      {/* 评论 */}
      <div class="mt-12">
        <Giscus />
      </div>
    </main>
  </div>
</Layout>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  const mapDiv = document.getElementById('route-map');
  if (mapDiv) {
    const points = (window as any).__TRAVELOG_POINTS__ || [];
    if (points.length > 0) {
      const map = L.map('route-map');
      
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 18,
      }).addTo(map);

      const latlngs = points.map((p: any) => [p.lat, p.lng] as [number, number]);
      const polyline = L.polyline(latlngs, {
        color: '#c41e3a',
        weight: 3
      }).addTo(map);

      map.fitBounds(polyline.getBounds(), { padding: [20, 20] });

      points.forEach((point: any, index: number) => {
        L.circleMarker([point.lat, point.lng], {
          radius: 8,
          fillColor: '#c41e3a',
          color: '#fff',
          weight: 2
        }).bindPopup(`<strong>${point.name}</strong>`).addTo(map);
      });
    }
  }
</script>
