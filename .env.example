# 西藏时空地图志 - 环境变量配置
# 复制此文件为 .env 后填入实际值

# 站点配置
PUBLIC_SITE_TITLE=西藏时空地图志
PUBLIC_MAP_CENTER=29.65,91.10
PUBLIC_MAP_ZOOM=7

# 天地图瓦片（部署时填入实际 key）
# PUBLIC_TILE_URL=https://t0.tianditu.gov.cn/img-w/wmts?SERVICE=WMTS&REQUEST=GetTile&VERSION=1.0.0&LAYER=img&STYLE=default&TILEMATRIXSET=w&FORMAT=tiles&TILEMATRIX={z}&TILEROW={y}&TILECOL={x}&tk=你的天地图key

# 腾讯云 COS（图片外链基础 URL，部署时填入）
# COS_BASE_URL=https://你的COS域名/

# Netlify Identity（部署时由 Netlify 自动提供）
# NETLIFY_IDENTITY_URL=https://your-site.netlify.app/.netlify/identity
